# Supabase Postgres connection string. Use the "Session pooler" URI from
# your Supabase project's Database settings — the direct connection host
# is IPv6-only and won't resolve on most networks/CI. See README.md for
# where to find this.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Gemini API key from Google AI Studio (aistudio.google.com/apikey).
# See README.md for how to get a free-tier key.
GOOGLE_API_KEY=your-google-api-key-here

# Comma-separated list of origins allowed to call this API. Leave unset
# for local dev (defaults to the Vite dev server on localhost:5173). Set
# this in production to your deployed frontend's real origin(s), e.g.:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=
